{
  "name": "campus-wide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-sw.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lighthouse": "node scripts/lighthouse.mjs",
    "prepare": "husky",
    "lighthouse:server": "node scripts/with-server.mjs pnpm lighthouse",
    "screenshots": "node scripts/with-server.mjs node scripts/screenshots.mjs",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "policies:sync": "node scripts/sync-policies.mjs",
    "build:sw": "node scripts/build-sw.mjs",
    "push:keys": "node scripts/gen-vapid.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@huggingface/transformers": "^4.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rough-notation": "^0.5.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "chrome-launcher": "^1.2.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.4.2",
  "description": "A multi-tenant, university-verified student community platform.",
  "license": "MIT",
  "engines": {
    "node": "^24.0.0"
  }
