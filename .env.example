# Campus Wide — environment variables
# Copy to .env.local for development. Never commit real values.
# Production values live only in Vercel project settings.

# --- App -------------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Supabase (Phase 2) ----------------------------------------------------
# Project URL and the publishable (browser-safe) key. The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Pooled connection for the app (transaction mode) and direct connection for migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Email (Phase 2) — Resend free tier: 100/day, 3,000/month --------------
RESEND_API_KEY=
EMAIL_FROM="Campus Wide <no-reply@example.edu>"

# --- Rate limiting + bot protection (required in production) ---------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cookieless analytics (optional; script is skipped when unset or GPC is on)
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Server-side AI (optional, opt-in per campus; Phase 6) -----------------
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Feedback forwarding (optional; Phase 5) -------------------------------
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=AdityaKumar0927/campus-wide
FEEDBACK_ADMIN_EMAIL=

# --- Web Push (Phase 7) ----------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Scheduled jobs --------------------------------------------------------
CRON_SECRET=
