# Campus Wide — environment variables
# Copy to .env.local for development. Never commit real values.
# Production values live only in Vercel project settings.

# --- App -------------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Supabase (Phase 2) ----------------------------------------------------
# Local development: run `pnpm db:start` and copy the printed values (URL http://127.0.0.1:54321,
# Postgres 54322, Mailpit 54324). Production values come from the Supabase dashboard.
# Project URL and the publishable (browser-safe) key. The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Pooled connection for the app (transaction mode) and direct connection for migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Email (Phase 3) — Resend free tier: 100/day, 3,000/month --------------
# Without RESEND_API_KEY every non-auth email is recorded as skipped (never sent). The daily budget
# keeps headroom for the auth mail Supabase sends on its own.
RESEND_API_KEY=
EMAIL_FROM="Campus Wide <no-reply@example.edu>"
EMAIL_DAILY_BUDGET=80

# --- Rate limiting + bot protection (required in production) ---------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cookieless analytics (optional; script is skipped when unset or GPC is on)
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- AI (Phase 6) ------------------------------------------------------------
# Browser models (duplicate-question suggestions, toxicity nudge) run on the device and download from
# huggingface.co on first use; set to 1 to enable. Off by default so a fresh deploy ships no model traffic.
NEXT_PUBLIC_BROWSER_AI=
# Optional server fallback for summaries, translation, mod-queue triage labels, and paste-to-event. Off
# unless the key is set AND the campus admin switches ai_server on. Input is PII-scrubbed first.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Feedback forwarding (optional; Phase 5) -------------------------------
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=AdityaKumar0927/campus-wide
FEEDBACK_ADMIN_EMAIL=

# --- Web Push (Phase 7) ----------------------------------------------------
# Generate a pair with: pnpm push:keys. Without them the app simply has no push, and the weekly
# digest carries everything instead.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.edu
# Shared with the database (platform_settings.push_dispatch_secret) so pg_net can call the dispatch
# route when a notification row is written.
PUSH_DISPATCH_SECRET=

# --- Tests ---------------------------------------------------------------
# Integration and E2E tests read sign-in codes from the local mail catcher.
MAILPIT_URL=http://127.0.0.1:54324

# --- Scheduled jobs --------------------------------------------------------
CRON_SECRET=
